{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "LogFilePath": "logs/covid-portal-api-.log"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=covidportal.db"
  },
  "MohApi": {
    "BaseUrl": "https://raw.githubusercontent.com/MoH-Malaysia/covid19-public/main/",
    "NationalCasesPath": "epidemic/cases_malaysia.csv",
    "StateCasesPath": "epidemic/cases_state.csv",
    "NationalDeathsPath": "epidemic/deaths_malaysia.csv",
    "StateDeathsPath": "epidemic/deaths_state.csv",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "CacheMinutes": 60
  },
  "CovidDataSync": {
    "Enabled": true,
    "InitialDelaySeconds": 5,
    "IntervalHours": 12
  }
}
