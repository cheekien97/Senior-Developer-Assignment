@model AuditTrailViewModel
@{
    ViewData["Title"] = "Audit Trail";
    var maxDate = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
}

<div class="page-head rise rise-1">
    <h1>Audit Trail</h1>
    <p class="lead-sub">Immutable record of critical actions performed in the portal</p>
</div>

<form asp-controller="Audit" asp-action="Index" method="get" class="card filter-card mb-4 rise rise-2">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label for="dateRange" class="form-label">Date range</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                    <input type="text" id="dateRange" class="form-control" placeholder="Select a date range"
                           autocomplete="off" aria-label="Date range" data-date-range data-max="@maxDate" />
                </div>
                <input asp-for="From" type="hidden" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
                <input asp-for="To" type="hidden" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Action" class="form-label"></label>
                <select asp-for="Action" asp-items="@Model.Actions" class="form-select"></select>
            </div>
            <div class="col-12 col-md-3 d-grid d-md-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
                <a asp-controller="Audit" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info" role="alert">@Model.Message</div>
}

@if (Model.Results.Count > 0)
{
    <div class="card rise rise-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="bi bi-shield-check me-2 text-primary"></i>Audit Entries</span>
            <span class="badge soft">@Model.Results.Count entries</span>
        </div>
        <div class="table-responsive table-scroll">
            <table id="auditTable" class="table table-striped table-hover align-middle mb-0"
                   data-enhance data-page-size="#auditPageSize" data-pager="#auditPager" data-page-info="#auditPageInfo">
                <thead class="table-light">
                    <tr>
                        <th scope="col" data-sort-type="date">Timestamp (UTC)</th>
                        <th scope="col" data-sort-type="text">Action</th>
                        <th scope="col" data-sort-type="text">Actor</th>
                        <th scope="col" data-sort-type="text">Description</th>
                        <th scope="col">Parameters</th>
                        <th scope="col" data-sort-type="text">IP Address</th>
                        <th scope="col">Correlation Id</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results)
                    {
                        <tr>
                            <td class="text-nowrap" data-sort-value="@row.TimestampUtc.ToString("o")">@row.TimestampUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td><span class="badge soft">@row.Action</span></td>
                            <td>@row.Actor</td>
                            <td>@row.Description</td>
                            <td><code class="small">@(string.IsNullOrEmpty(row.Parameters) ? "—" : row.Parameters)</code></td>
                            <td>@(string.IsNullOrEmpty(row.IpAddress) ? "—" : row.IpAddress)</td>
                            <td><code class="small">@row.CorrelationId</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="auditPageSize" class="text-muted small mb-0">Rows per page</label>
                <select id="auditPageSize" class="form-select form-select-sm" style="width: 5rem;">
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <span id="auditPageInfo" class="text-muted small"></span>
            <nav aria-label="Audit pages">
                <ul id="auditPager" class="pagination pagination-sm mb-0"></ul>
            </nav>
        </div>
    </div>
}
