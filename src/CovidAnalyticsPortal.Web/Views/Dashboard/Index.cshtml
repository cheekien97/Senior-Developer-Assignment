@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var maxDate = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
}

<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-2 rise rise-1">
    <div>
        <h1>National Dashboard</h1>
        <p class="lead-sub">COVID-19 summary for Malaysia</p>
    </div>
    @if (Model.HasData)
    {
        <span class="pill-date align-self-center"><i class="bi bi-calendar3"></i> As of @Model.Summary!.AsOfDate.ToString("dd MMM yyyy")</span>
    }
</div>

<form asp-controller="Dashboard" asp-action="Index" method="get" class="card filter-card mb-4 rise rise-2">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label asp-for="From" class="form-label"></label>
                <input asp-for="From" type="date" class="form-control" max="@maxDate" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="To" class="form-label"></label>
                <input asp-for="To" type="date" class="form-control" max="@maxDate" />
            </div>
            <div class="col-12 col-md-4 d-grid d-md-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Apply Filter
                </button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning" role="alert">@Model.Message</div>
}

@if (Model.HasData)
{
    var s = Model.Summary!;
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card stat-card--cases h-100 rise rise-1">
                <span class="stat-card__glow"></span>
                <div class="stat-card__icon"><i class="bi bi-virus2"></i></div>
                <div class="stat-card__label">Total Cases</div>
                <div class="stat-card__value">@s.TotalCases.ToString("N0")</div>
                <div class="stat-card__meta"><i class="bi bi-arrow-up-short"></i> +@s.NewCasesToday.ToString("N0") new today</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card stat-card--deaths h-100 rise rise-2">
                <span class="stat-card__glow"></span>
                <div class="stat-card__icon"><i class="bi bi-heartbreak"></i></div>
                <div class="stat-card__label">Total Deaths</div>
                <div class="stat-card__value">@s.TotalDeaths.ToString("N0")</div>
                <div class="stat-card__meta"><i class="bi bi-arrow-up-short"></i> +@s.NewDeathsToday.ToString("N0") new today</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card stat-card--active h-100 rise rise-3">
                <span class="stat-card__glow"></span>
                <div class="stat-card__icon"><i class="bi bi-activity"></i></div>
                <div class="stat-card__label">Active Cases</div>
                <div class="stat-card__value">@s.ActiveCases.ToString("N0")</div>
                <div class="stat-card__meta"><i class="bi bi-dot"></i> Currently infectious</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card stat-card--recovered h-100 rise rise-4">
                <span class="stat-card__glow"></span>
                <div class="stat-card__icon"><i class="bi bi-heart-pulse"></i></div>
                <div class="stat-card__label">Recovered</div>
                <div class="stat-card__value">@s.TotalRecovered.ToString("N0")</div>
                <div class="stat-card__meta"><i class="bi bi-check2"></i> Over the period</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card h-100 rise rise-3">
                <div class="card-header"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Cases by State</div>
                <div class="card-body">
                    <canvas id="stateCasesChart" height="140"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-5">
            <div class="card h-100 rise rise-4">
                <div class="card-header"><i class="bi bi-list-columns-reverse me-2 text-primary"></i>State Breakdown</div>
                <div class="table-responsive" style="max-height: 420px;">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th scope="col">State</th>
                                <th scope="col" class="text-end">New Cases</th>
                                <th scope="col" class="text-end">Active</th>
                                <th scope="col" class="text-end">Deaths</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in s.StateBreakdown.OrderByDescending(r => r.NewCases))
                            {
                                <tr>
                                    <td>@row.StateName</td>
                                    <td class="text-end">@row.NewCases.ToString("N0")</td>
                                    <td class="text-end">@row.ActiveCases.ToString("N0")</td>
                                    <td class="text-end">@row.NewDeaths.ToString("N0")</td>
                                </tr>
                            }
                            @if (s.StateBreakdown.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No state data available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.HasData && Model.Summary!.StateBreakdown.Count > 0)
    {
        var ordered = Model.Summary!.StateBreakdown.OrderByDescending(r => r.NewCases).ToList();
        var labels = System.Text.Json.JsonSerializer.Serialize(ordered.Select(r => r.StateName));
        var values = System.Text.Json.JsonSerializer.Serialize(ordered.Select(r => r.NewCases));
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const ctx = document.getElementById('stateCasesChart');
                if (!ctx) return;
                Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
                Chart.defaults.color = '#64748b';
                const g = ctx.getContext('2d').createLinearGradient(0, 0, 0, 320);
                g.addColorStop(0, 'rgba(99, 102, 241, .95)');
                g.addColorStop(1, 'rgba(124, 58, 237, .65)');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(labels),
                        datasets: [{
                            label: 'New Cases',
                            data: @Html.Raw(values),
                            backgroundColor: g,
                            borderColor: 'transparent',
                            borderRadius: 8,
                            borderSkipped: false,
                            maxBarThickness: 38
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a', padding: 12, cornerRadius: 10,
                                titleColor: '#fff', bodyColor: '#e2e8f0'
                            }
                        },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(148,163,184,.15)' }, border: { display: false } },
                            x: { grid: { display: false }, border: { display: false } }
                        }
                    }
                });
            })();
        </script>
    }
}
