@model StateStatisticsViewModel
@{
    ViewData["Title"] = "State Statistics";
    var maxDate = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
}

<div class="page-head rise rise-1">
    <h1>State Statistics</h1>
    <p class="lead-sub">Per-state COVID-19 figures for a selected period</p>
</div>

<form asp-controller="Statistics" asp-action="Index" method="get" class="card filter-card mb-4 rise rise-2">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label for="dateRange" class="form-label">Date range</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                    <input type="text" id="dateRange" class="form-control" placeholder="Select a date range"
                           autocomplete="off" aria-label="Date range" data-date-range data-max="@maxDate" />
                </div>
                <input asp-for="From" type="hidden" value="@Model.From.ToString("yyyy-MM-dd")" />
                <input asp-for="To" type="hidden" value="@Model.To.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="State" class="form-label"></label>
                <select asp-for="State" asp-items="@Model.States" class="form-select"></select>
            </div>
            <div class="col-12 col-md-4 d-grid d-md-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
                <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info" role="alert">@Model.Message</div>
}

@if (Model.Searched && Model.Results.Count > 0)
{
    <div class="card rise rise-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="bi bi-table me-2 text-primary"></i>Results</span>
            <span class="badge soft">@Model.Results.Count rows</span>
        </div>
        <div class="table-responsive table-scroll">
            <table id="statsTable" class="table table-striped table-hover align-middle mb-0"
                   data-enhance data-page-size="#pageSize" data-pager="#pager" data-page-info="#pageInfo">
                <thead class="table-light">
                    <tr>
                        <th scope="col" data-sort-type="date">Date</th>
                        <th scope="col" data-sort-type="text">State</th>
                        <th scope="col" class="text-end" data-sort-type="number">New Cases</th>
                        <th scope="col" class="text-end" data-sort-type="number">Cumulative</th>
                        <th scope="col" class="text-end" data-sort-type="number">Active</th>
                        <th scope="col" class="text-end" data-sort-type="number">Recovered</th>
                        <th scope="col" class="text-end" data-sort-type="number">New Deaths</th>
                        <th scope="col" class="text-end" data-sort-type="number">Total Deaths</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results.OrderBy(r => r.Date).ThenBy(r => r.StateName))
                    {
                        <tr>
                            <td data-sort-value="@row.Date.ToString("yyyy-MM-dd")">@row.Date.ToString("dd MMM yyyy")</td>
                            <td>@row.StateName</td>
                            <td class="text-end" data-sort-value="@row.NewCases">@row.NewCases.ToString("N0")</td>
                            <td class="text-end" data-sort-value="@row.CumulativeCases">@row.CumulativeCases.ToString("N0")</td>
                            <td class="text-end" data-sort-value="@row.ActiveCases">@row.ActiveCases.ToString("N0")</td>
                            <td class="text-end" data-sort-value="@row.Recovered">@row.Recovered.ToString("N0")</td>
                            <td class="text-end" data-sort-value="@row.NewDeaths">@row.NewDeaths.ToString("N0")</td>
                            <td class="text-end" data-sort-value="@row.CumulativeDeaths">@row.CumulativeDeaths.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="pageSize" class="text-muted small mb-0">Rows per page</label>
                <select id="pageSize" class="form-select form-select-sm" style="width: 5rem;">
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <span id="pageInfo" class="text-muted small"></span>
            <nav aria-label="Results pages">
                <ul id="pager" class="pagination pagination-sm mb-0"></ul>
            </nav>
        </div>
    </div>
}


