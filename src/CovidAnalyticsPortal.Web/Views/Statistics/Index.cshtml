@model StateStatisticsViewModel
@{
    ViewData["Title"] = "State Statistics";
}

<div class="mb-4">
    <h1 class="h3 mb-0">State Statistics</h1>
    <p class="text-muted mb-0">Per-state COVID-19 figures for a selected period</p>
</div>

<form asp-controller="Statistics" asp-action="Index" method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label asp-for="From" class="form-label"></label>
                <input asp-for="From" type="date" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="To" class="form-label"></label>
                <input asp-for="To" type="date" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="State" class="form-label"></label>
                <select asp-for="State" asp-items="@Model.States" class="form-select"></select>
            </div>
            <div class="col-12 col-md-3 d-grid d-md-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
                <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info" role="alert">@Model.Message</div>
}

@if (Model.Searched && Model.Results.Count > 0)
{
    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
            <span>Results</span>
            <span class="badge bg-secondary">@Model.Results.Count rows</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">State</th>
                        <th scope="col" class="text-end">New Cases</th>
                        <th scope="col" class="text-end">Cumulative</th>
                        <th scope="col" class="text-end">Active</th>
                        <th scope="col" class="text-end">Recovered</th>
                        <th scope="col" class="text-end">New Deaths</th>
                        <th scope="col" class="text-end">Total Deaths</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results.OrderBy(r => r.Date).ThenBy(r => r.StateName))
                    {
                        <tr>
                            <td>@row.Date.ToString("dd MMM yyyy")</td>
                            <td>@row.StateName</td>
                            <td class="text-end">@row.NewCases.ToString("N0")</td>
                            <td class="text-end">@row.CumulativeCases.ToString("N0")</td>
                            <td class="text-end">@row.ActiveCases.ToString("N0")</td>
                            <td class="text-end">@row.Recovered.ToString("N0")</td>
                            <td class="text-end">@row.NewDeaths.ToString("N0")</td>
                            <td class="text-end">@row.CumulativeDeaths.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
