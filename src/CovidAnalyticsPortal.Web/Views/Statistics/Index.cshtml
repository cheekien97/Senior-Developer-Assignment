@model StateStatisticsViewModel
@{
    ViewData["Title"] = "State Statistics";
    var maxDate = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
}

<div class="page-head rise rise-1">
    <h1>State Statistics</h1>
    <p class="lead-sub">Per-state COVID-19 figures for a selected period</p>
</div>

<form asp-controller="Statistics" asp-action="Index" method="get" class="card filter-card mb-4 rise rise-2">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label asp-for="From" class="form-label"></label>
                <input asp-for="From" type="date" class="form-control" max="@maxDate" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="To" class="form-label"></label>
                <input asp-for="To" type="date" class="form-control" max="@maxDate" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="State" class="form-label"></label>
                <select asp-for="State" asp-items="@Model.States" class="form-select"></select>
            </div>
            <div class="col-12 col-md-3 d-grid d-md-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
                <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info" role="alert">@Model.Message</div>
}

@if (Model.Searched && Model.Results.Count > 0)
{
    <div class="card rise rise-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-table me-2 text-primary"></i>Results</span>
            <span class="badge soft">@Model.Results.Count rows</span>
        </div>
        <div class="table-responsive">
            <table id="statsTable" class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">State</th>
                        <th scope="col" class="text-end">New Cases</th>
                        <th scope="col" class="text-end">Cumulative</th>
                        <th scope="col" class="text-end">Active</th>
                        <th scope="col" class="text-end">Recovered</th>
                        <th scope="col" class="text-end">New Deaths</th>
                        <th scope="col" class="text-end">Total Deaths</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results.OrderBy(r => r.Date).ThenBy(r => r.StateName))
                    {
                        <tr>
                            <td>@row.Date.ToString("dd MMM yyyy")</td>
                            <td>@row.StateName</td>
                            <td class="text-end">@row.NewCases.ToString("N0")</td>
                            <td class="text-end">@row.CumulativeCases.ToString("N0")</td>
                            <td class="text-end">@row.ActiveCases.ToString("N0")</td>
                            <td class="text-end">@row.Recovered.ToString("N0")</td>
                            <td class="text-end">@row.NewDeaths.ToString("N0")</td>
                            <td class="text-end">@row.CumulativeDeaths.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="pageSize" class="text-muted small mb-0">Rows per page</label>
                <select id="pageSize" class="form-select form-select-sm" style="width: 5rem;">
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <span id="pageInfo" class="text-muted small"></span>
            <nav aria-label="Results pages">
                <ul id="pager" class="pagination pagination-sm mb-0"></ul>
            </nav>
        </div>
    </div>
}

@section Scripts {
    @if (Model.Searched && Model.Results.Count > 0)
    {
        <script>
            (function () {
                const table = document.getElementById('statsTable');
                if (!table) return;
                const rows = Array.from(table.tBodies[0].rows);
                const pageSizeSel = document.getElementById('pageSize');
                const pager = document.getElementById('pager');
                const info = document.getElementById('pageInfo');
                let pageSize = parseInt(pageSizeSel.value, 10);
                let current = 1;

                function totalPages() { return Math.max(1, Math.ceil(rows.length / pageSize)); }

                function render() {
                    const pages = totalPages();
                    current = Math.min(current, pages);
                    const start = (current - 1) * pageSize;
                    const end = start + pageSize;
                    rows.forEach((r, i) => { r.style.display = (i >= start && i < end) ? '' : 'none'; });

                    const shown = Math.min(end, rows.length);
                    info.textContent = `Showing ${rows.length ? start + 1 : 0}–${shown} of ${rows.length}`;
                    buildPager(pages);
                }

                function pageItem(label, page, opts = {}) {
                    const li = document.createElement('li');
                    li.className = 'page-item' + (opts.active ? ' active' : '') + (opts.disabled ? ' disabled' : '');
                    const a = document.createElement('a');
                    a.className = 'page-link';
                    a.href = '#';
                    a.innerHTML = label;
                    if (!opts.disabled && !opts.active && page) {
                        a.addEventListener('click', e => { e.preventDefault(); current = page; render(); });
                    } else {
                        a.addEventListener('click', e => e.preventDefault());
                    }
                    li.appendChild(a);
                    return li;
                }

                function buildPager(pages) {
                    pager.innerHTML = '';
                    pager.appendChild(pageItem('&laquo;', current - 1, { disabled: current === 1 }));

                    const win = 2;
                    const nums = new Set([1, pages]);
                    for (let p = current - win; p <= current + win; p++) {
                        if (p >= 1 && p <= pages) nums.add(p);
                    }
                    const sorted = Array.from(nums).sort((a, b) => a - b);
                    let prev = 0;
                    for (const p of sorted) {
                        if (p - prev > 1) {
                            const li = document.createElement('li');
                            li.className = 'page-item disabled';
                            li.innerHTML = '<span class="page-link">…</span>';
                            pager.appendChild(li);
                        }
                        pager.appendChild(pageItem(p, p, { active: p === current }));
                        prev = p;
                    }

                    pager.appendChild(pageItem('&raquo;', current + 1, { disabled: current === pages }));
                }

                pageSizeSel.addEventListener('change', () => {
                    pageSize = parseInt(pageSizeSel.value, 10);
                    current = 1;
                    render();
                });

                render();
            })();
        </script>
    }
}
