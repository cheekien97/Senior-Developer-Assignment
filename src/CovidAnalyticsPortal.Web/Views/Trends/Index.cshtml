@model TrendAnalysisViewModel
@{
    ViewData["Title"] = "Trend Analysis";
    var maxDate = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");

    string DirectionBadge(string direction) => direction switch
    {
        "Increasing" => "text-bg-danger",
        "Decreasing" => "text-bg-success",
        _ => "text-bg-secondary",
    };
}

<div class="page-head rise rise-1">
    <h1>Trend Analysis</h1>
    <p class="lead-sub">Track how a metric evolves over a chosen period</p>
</div>

<form asp-controller="Trends" asp-action="Index" method="get" class="card filter-card mb-4 rise rise-2">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label asp-for="Metric" class="form-label"></label>
                <select asp-for="Metric" asp-items="@Model.Metrics" class="form-select"></select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="From" class="form-label"></label>
                <input asp-for="From" type="date" class="form-control" max="@maxDate" />
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="To" class="form-label"></label>
                <input asp-for="To" type="date" class="form-control" max="@maxDate" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="State" class="form-label"></label>
                <select asp-for="State" asp-items="@Model.States" class="form-select"></select>
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-graph-up"></i> Analyse
                </button>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info" role="alert">@Model.Message</div>
}

@if (Model.Searched && Model.Trend is not null && Model.Trend.Points.Count > 0)
{
    var t = Model.Trend;
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card kpi-card rise rise-1">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="kpi-label">Start Value</div>
                        <div class="kpi-value">@t.StartValue.ToString("N0")</div>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-flag"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card kpi-card rise rise-2">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="kpi-label">End Value</div>
                        <div class="kpi-value">@t.EndValue.ToString("N0")</div>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-flag-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card kpi-card rise rise-3">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="kpi-label">Change</div>
                        <div class="kpi-value">@t.ChangeValue.ToString("N0") <span class="fs-6 text-muted">(@t.ChangePercentage.ToString("N1")%)</span></div>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-arrow-left-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card kpi-card rise rise-4">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="kpi-label">Direction</div>
                        <span class="badge @DirectionBadge(t.Direction) fs-6 mt-1">@t.Direction</span>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-graph-up-arrow"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card rise rise-4">
        <div class="card-header">
            <i class="bi bi-activity me-2 text-primary"></i>@t.Metric &mdash; @(string.IsNullOrEmpty(t.StateName) ? "National" : t.StateName)
            <span class="text-muted fw-normal">(@t.PeriodStart.ToString("dd MMM yyyy") – @t.PeriodEnd.ToString("dd MMM yyyy"))</span>
        </div>
        <div class="card-body">
            <canvas id="trendChart" height="110"></canvas>
        </div>
    </div>
}

@section Scripts {
    @if (Model.Searched && Model.Trend is not null && Model.Trend.Points.Count > 0)
    {
        var labels = System.Text.Json.JsonSerializer.Serialize(
            Model.Trend.Points.Select(p => p.Date.ToString("dd MMM")));
        var values = System.Text.Json.JsonSerializer.Serialize(
            Model.Trend.Points.Select(p => p.Value));
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const ctx = document.getElementById('trendChart');
                if (!ctx) return;
                Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
                Chart.defaults.color = '#64748b';
                const fill = ctx.getContext('2d').createLinearGradient(0, 0, 0, 280);
                fill.addColorStop(0, 'rgba(99, 102, 241, .28)');
                fill.addColorStop(1, 'rgba(99, 102, 241, 0)');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(labels),
                        datasets: [{
                            label: '@Html.Raw(Model.Trend.Metric)',
                            data: @Html.Raw(values),
                            fill: true,
                            tension: 0.4,
                            backgroundColor: fill,
                            borderColor: '#6366f1',
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: '#6366f1',
                            pointHoverBorderColor: '#fff',
                            pointHoverBorderWidth: 2,
                            borderWidth: 2.5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a', padding: 12, cornerRadius: 10,
                                titleColor: '#fff', bodyColor: '#e2e8f0'
                            }
                        },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(148,163,184,.15)' }, border: { display: false } },
                            x: { grid: { display: false }, border: { display: false } }
                        }
                    }
                });
            })();
        </script>
    }
}
